[
  {
    "id": 1,
    "title": "Reading the Resident Records",
    "description": "The `record_fields` catalogue names every record-book in the city, one field inside it, and what that field stores. List each `field` and what it `stores` for the `resident` book, in alphabetical order by `field`.",
    "sampleColumns": [
      "field",
      "stores"
    ],
    "sampleRows": [
      [
        "sample_field_a",
        "text"
      ],
      [
        "sample_field_b",
        "integer"
      ]
    ],
    "ordered": true,
    "schema": [
      {
        "name": "record_fields",
        "columns": [
          {
            "name": "book",
            "type": "text",
            "note": "which record-book this field belongs to"
          },
          {
            "name": "field",
            "type": "text",
            "note": "a field inside that book"
          },
          {
            "name": "stores",
            "type": "text",
            "note": "the kind of value the field stores"
          },
          {
            "name": "is_key",
            "type": "boolean"
          }
        ],
        "sampleRows": [
          [
            "resident",
            "resident_id",
            "integer",
            true
          ],
          [
            "resident",
            "full_name",
            "text",
            false
          ],
          [
            "shelter",
            "capacity",
            "integer",
            false
          ]
        ]
      }
    ],
    "starterSql": "SELECT field, stores\nFROM record_fields\nORDER BY field;",
    "status": "drafted",
    "hintCount": 1,
    "fixtureSql": "CREATE TABLE \"record_fields\" (\"book\" text, \"field\" text, \"stores\" text, \"is_key\" boolean);\nINSERT INTO \"record_fields\" VALUES\n('resident', 'resident_id', 'integer', true),\n('resident', 'name', 'text', false),\n('shelter', 'capacity', 'integer', false),\n('resident', 'home_id', 'integer', false),\n(NULL, 'unknown', 'text', false);",
    "expected": {
      "columns": [
        "field",
        "stores"
      ],
      "rows": [
        {
          "field": "home_id",
          "stores": "integer"
        },
        {
          "field": "name",
          "stores": "text"
        },
        {
          "field": "resident_id",
          "stores": "integer"
        }
      ]
    }
  },
