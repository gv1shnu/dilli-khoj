  {
    "id": 4,
    "title": "Evidence of the Rebuild",
    "description": "The `change_log` records every edit to the archives — some change a book's structure, others its contents. Show the `target` and `edit` for rows whose `change_type` is `structure`, newest `changed_at` first.",
    "sampleColumns": [
      "target",
      "edit"
    ],
    "sampleRows": [
      [
        "sample_book",
        "built the book"
      ],
      [
        "sample_field",
        "renamed a field"
      ]
    ],
    "ordered": true,
    "schema": [
      {
        "name": "change_log",
        "columns": [
          {
            "name": "edit",
            "type": "text",
            "note": "what was done, e.g. built the book, added records"
          },
          {
            "name": "target",
            "type": "text",
            "note": "the record-book affected"
          },
          {
            "name": "change_type",
            "type": "text",
            "note": "structure: changes the book's shape; contents: changes its records"
          },
          {
            "name": "changed_at",
            "type": "timestamp"
          }
        ],
        "sampleRows": [
          [
            "built the book",
            "shelters",
            "structure",
            "2042-01-02 10:00:00"
          ],
          [
            "renamed a field",
            "pumps",
            "structure",
            "2042-01-03 10:00:00"
          ],
          [
            "added records",
            "residents",
            "contents",
            "2042-01-04 10:00:00"
          ]
        ]
      }
    ],
    "starterSql": "SELECT target, edit\nFROM change_log\nORDER BY changed_at DESC;",
    "status": "drafted",
    "hintCount": 1,
    "fixtureSql": "CREATE TABLE \"change_log\" (\"edit\" text, \"target\" text, \"change_type\" text, \"changed_at\" timestamp);\nINSERT INTO \"change_log\" VALUES\n('built the book', 'shelters', 'structure', '2042-01-02 10:00:00'),\n('added records', 'residents', 'contents', '2042-01-04 10:00:00'),\n('renamed a field', 'pumps', 'structure', '2042-01-03 10:00:00'),\n('edited records', 'pumps', 'contents', NULL);",
    "expected": {
      "columns": [
        "target",
        "edit"
      ],
      "rows": [
        {
          "target": "pumps",
          "edit": "renamed a field"
        },
        {
          "target": "shelters",
          "edit": "built the book"
        }
      ]
    }
